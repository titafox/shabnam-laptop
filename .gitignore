build/
out/
__pycache__/
*.class
*.o
*.mod.c
.DS_Store
lan-helper/events.jsonl
lan-helper/shots/
lan-helper/last-shot.png
lan-helper/log/
log/
rkdeveloptool/
.superpowers/
