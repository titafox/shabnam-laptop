+/// Shabnam: files a later `gem-player FILE...` handed to this player (see `running_player`) are
+/// played at once, in place of the queue, exactly as if the player had been started with them.
+fn poll_opened_files(ctx: &Context, gem: &mut GemPlayer) {
+    for paths in running_player::take_opened() {
+        let tracks = tracks_from_paths(paths);
+        if tracks.is_empty() {
+            continue;
+        }
+        gem.player.queue = tracks;
+        // "Repeat" would play the current track again instead of the first of these.
+        let repeat = take(&mut gem.player.repeat);
+        maybe_play_next(ctx, gem);
+        gem.player.repeat = repeat;
+    }
+}
+
+/// Shabnam: one player at a time. The first player listens on a socket in the user's runtime
+/// directory ($XDG_RUNTIME_DIR/gem-player.sock, a directory only that user can enter); a later
+/// `gem-player FILE...` writes its file names there and ends, and the first one plays them.
+/// Upstream has nothing of the kind: a second start was a second player on top of the first.
+/// A start without files is not handed over (it opens a window as before).
+mod running_player {
+    use std::{
+        io::{Read, Write},
+        os::unix::{
+            ffi::{OsStrExt, OsStringExt},
+            net::{UnixListener, UnixStream},
+        },
+        path::PathBuf,
+        sync::Mutex,
+        thread,
+        time::Duration,
+    };
+
+    static OPENED: Mutex<Vec<Vec<PathBuf>>> = Mutex::new(Vec::new());
+
+    fn socket() -> Option<PathBuf> {
+        let dir = PathBuf::from(std::env::var_os("XDG_RUNTIME_DIR")?);
+        dir.is_absolute().then(|| dir.join("gem-player.sock"))
+    }
+
+    /// True when a running player took this start's files. File names go as absolute paths with
+    /// a zero byte after each.
+    pub fn hand_over() -> bool {
+        let paths: Vec<PathBuf> =
+            std::env::args_os().skip(1).filter_map(|arg| std::path::absolute(PathBuf::from(arg)).ok()).collect();
+        if paths.is_empty() {
+            return false;
+        }
+        let Some(mut stream) = socket().and_then(|socket| UnixStream::connect(socket).ok()) else {
+            return false;
+        };
+        let mut message = Vec::new();
+        for path in &paths {
+            message.extend_from_slice(path.as_os_str().as_bytes());
+            message.push(0);
+        }
+        stream.write_all(&message).is_ok()
+    }
+
+    /// Becomes the running player: later starts reach this one. A socket file left by a player
+    /// that is gone (nobody answers) is replaced.
+    pub fn listen(ctx: &egui::Context) {
+        let Some(socket) = socket() else {
+            return;
+        };
+        if UnixStream::connect(&socket).is_ok() {
+            return; // a player without files was started beside a running one; that one keeps the socket
+        }
+        let _ = std::fs::remove_file(&socket);
+        let Ok(listener) = UnixListener::bind(&socket) else {
+            return;
+        };
+        let ctx = ctx.clone();
+        thread::spawn(move || {
+            for stream in listener.incoming() {
+                let Ok(stream) = stream else {
+                    continue;
+                };
+                let _ = stream.set_read_timeout(Some(Duration::from_secs(2)));
+                let mut message = Vec::new();
+                if stream.take(1 << 20).read_to_end(&mut message).is_err() {
+                    continue;
+                }
+                let paths: Vec<PathBuf> = message
+                    .split(|byte| *byte == 0)
+                    .filter(|name| !name.is_empty())
+                    .map(|name| PathBuf::from(std::ffi::OsString::from_vec(name.to_vec())))
+                    .collect();
+                if !paths.is_empty() {
+                    OPENED.lock().unwrap().push(paths);
+                    ctx.request_repaint();
+                }
+            }
+        });
+    }
+
+    pub fn take_opened() -> Vec<Vec<PathBuf>> {
+        std::mem::take(&mut *OPENED.lock().unwrap())
+    }
+}
