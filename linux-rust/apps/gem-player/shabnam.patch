+/// Shabnam: `gem-player FILE...`. One file: that file, then the other audio files of its folder in
+/// name order (so "next" and "previous" work as in a folder view). Several files: those files.
+fn tracks_from_command_line() -> Vec<Track> {
+    let mut paths: Vec<PathBuf> = std::env::args_os()
+        .skip(1)
+        .map(PathBuf::from)
+        .filter(|path| path.is_file() && is_audio_file(path))
+        .collect();
+
+    if let [only] = paths.as_slice()
+        && let Some(folder) = only.parent()
+        && let Ok(entries) = std::fs::read_dir(folder)
+    {
+        let mut siblings: Vec<PathBuf> = entries
+            .filter_map(|entry| entry.ok().map(|entry| entry.path()))
+            .filter(|path| path.is_file() && is_audio_file(path))
+            .take(2000)
+            .collect();
+        siblings.sort();
+        if let Some(index) = siblings.iter().position(|path| path == only) {
+            siblings.rotate_left(index);
+            paths = siblings;
+        }
+    }
+
+    paths
+        .iter()
+        .filter_map(|path| match track::load_from_file(path) {
+            Ok(track) => Some(track),
+            Err(e) => {
+                warn!("Skipping '{}': {e}", path.display());
+                None
+            }
+        })
+        .collect()
+}
