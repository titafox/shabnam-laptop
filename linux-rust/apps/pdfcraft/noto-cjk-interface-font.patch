+/// Shabnam: every face of the Noto Sans CJK collection maps every Han character, so the first one
+/// with the probe would be the Japanese face (0). Its faces are JP, KR, SC, TC, HK: take SC (2)
+/// for Simplified and TC (3) for Traditional Chinese interface text.
+fn noto_cjk_face(path: &Path, bytes: &[u8], probe: char) -> Option<u32> {
+    use skrifa::MetadataProvider as _;
+    let index = match probe {
+        HANS_PROBE => 2,
+        HANT_PROBE => 3,
+        _ => return None,
+    };
+    let noto = path.file_name().and_then(|n| n.to_str()).is_some_and(|n| n.starts_with("NotoSansCJK"));
+    (noto && skrifa::FontRef::from_index(bytes, index).is_ok_and(|font| font.charmap().map(probe).is_some())).then_some(index)
+}
