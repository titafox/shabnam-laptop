diff --git a/src/i18n.rs b/src/i18n.rs
new file mode 100644
index 0000000..421c746
--- /dev/null
+++ b/src/i18n.rs
@@ -0,0 +1,208 @@
+//! Shabnam: Chinese and Russian interface text. Upstream Simp is English only.
+//!
+//! `tr("English text")` gives the text in the language of the session (LC_ALL, LC_MESSAGES or
+//! LANG, in that order: zh* = Simplified Chinese, ru* = Russian) and the English text itself for
+//! every other language and for a text that is not in the table. The English text is the key, so
+//! the rest of the program reads as before with `tr(..)` around what is shown.
+//!
+//! `add_cjk_font` gives egui a face with Chinese characters (its built-in faces have Latin and
+//! Cyrillic only), for the interface and for file names, in every language.
+
+use std::{collections::HashMap, sync::OnceLock};
+
+#[derive(Clone, Copy, PartialEq)]
+enum Lang {
+    En,
+    Zh,
+    Ru,
+}
+
+fn lang() -> Lang {
+    static LANG: OnceLock<Lang> = OnceLock::new();
+    *LANG.get_or_init(|| {
+        let locale = ["LC_ALL", "LC_MESSAGES", "LANG"]
+            .iter()
+            .filter_map(|name| std::env::var(name).ok())
+            .find(|value| !value.is_empty())
+            .unwrap_or_default();
+        if locale.starts_with("zh") {
+            Lang::Zh
+        } else if locale.starts_with("ru") {
+            Lang::Ru
+        } else {
+            Lang::En
+        }
+    })
+}
+
+pub fn tr(english: &'static str) -> &'static str {
+    static TABLE: OnceLock<HashMap<&'static str, (&'static str, &'static str)>> = OnceLock::new();
+    let lang = lang();
+    if lang == Lang::En {
+        return english;
+    }
+    let table = TABLE.get_or_init(|| TEXTS.iter().map(|&(en, zh, ru)| (en, (zh, ru))).collect());
+    match table.get(english) {
+        Some(&(zh, _)) if lang == Lang::Zh => zh,
+        Some(&(_, ru)) if lang == Lang::Ru => ru,
+        _ => english,
+    }
+}
+
+/// Noto Sans CJK as the last face of both egui font families. The file is a collection: faces
+/// 0 to 4 are Japanese, Korean, Simplified Chinese, Traditional Chinese, Hong Kong.
+pub fn add_cjk_font(ctx: &egui::Context) {
+    const FILES: &[&str] = &[
+        "/usr/share/fonts/noto/NotoSansCJK-Regular.ttc",
+        "/usr/share/fonts/noto-cjk/NotoSansCJK-Regular.ttc",
+        "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
+    ];
+    let Some(bytes) = FILES.iter().find_map(|file| std::fs::read(file).ok()) else {
+        return;
+    };
+    let mut data = egui::FontData::from_owned(bytes);
+    data.index = 2;
+    let mut fonts = egui::FontDefinitions::default();
