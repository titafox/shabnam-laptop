[Desktop Entry]
Version=1.0
Type=Application
Name=Files
Name[zh_CN]=文件
Name[ru]=Файлы
GenericName=File Manager
GenericName[zh_CN]=文件管理器
GenericName[ru]=Файловый менеджер
Comment=Browse and manage files
Comment[zh_CN]=浏览和管理文件
Comment[ru]=Просмотр файлов и управление ими
Exec=shabnam-files %U
Icon=/usr/share/shabnam/icons/files.png
Terminal=false
StartupWMClass=favnyr
Categories=System;FileManager;
MimeType=inode/directory;
