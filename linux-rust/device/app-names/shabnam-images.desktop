[Desktop Entry]
Version=1.0
Type=Application
Name=Images
Name[zh_CN]=图片
Name[ru]=Изображения
GenericName=Image Viewer
GenericName[zh_CN]=图片查看器
GenericName[ru]=Просмотр изображений
Comment=View, rotate and crop pictures (Simp)
Comment[zh_CN]=查看、旋转和裁剪图片（Simp）
Comment[ru]=Просмотр, поворот и обрезка изображений (Simp)
Exec=shabnam-images %f
Icon=/usr/local/share/shabnam-apps/simp.png
Terminal=false
StartupWMClass=simp
Categories=Graphics;Viewer;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/svg+xml;image/tiff;image/x-icon;image/vnd.microsoft.icon;image/x-tga;image/qoi;image/vnd.adobe.photoshop;image/x-exr;
