<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkWindow" id="w">
    <property name="title">中文输入测试 — Shabnam IME test</property>
    <property name="default-width">560</property>
    <property name="default-height">360</property>
    <child>
      <object class="GtkBox">
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin">16</property>
        <child><object class="GtkLabel"><property name="visible">1</property><property name="xalign">0</property>
          <property name="label">你好，世界！这是中文显示测试：简体字、标点“”、数字 123、English、Салом.
按 Ctrl+空格 切换拼音，然后在下面输入 nihao。</property></object></child>
        <child><object class="GtkEntry" id="e"><property name="visible">1</property>
          <property name="placeholder-text">在这里打字 / type here</property></object></child>
        <child><object class="GtkScrolledWindow"><property name="visible">1</property><property name="vexpand">1</property>
          <child><object class="GtkTextView"><property name="visible">1</property><property name="monospace">1</property></object></child>
        </object></child>
      </object>
    </child>
  </object>
</interface>
