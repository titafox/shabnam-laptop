// Shabnam desktop. Mod = the Win key.
// Wallpaper.
spawn-at-startup "sh" "-c" "awww-daemon >/var/log/shabnam/awww.log 2>&1 & sleep 1; awww img /usr/share/shabnam/wallpaper.jpg --transition-type none"
// Shelf, launcher and quick settings (restarted if it ever stops while the desktop is up).
spawn-at-startup "sh" "-c" "while pidof niri-mali >/dev/null; do shabnam-shell >>/var/log/shabnam/shabnam-shell.log 2>&1; sleep 1; done"
// Chinese input method: Ctrl+Space switches.
spawn-at-startup "shabnam-ime"

output "eDP-1" { scale 1.5; }
// Touchpad: tap to click, two-finger tap or two-finger press = right click, three-finger tap = middle.
input {
    // Latin and Russian layouts; Alt+Shift switches. Chinese is typed through the input method
    // (Ctrl+Space) on top of the Latin layout.
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
    }
    touchpad {
        tap
        click-method "clickfinger"
        dwt
        natural-scroll
    }
}
// Windows draw their own title bar (with a close button). niri draws none itself, so asking
// applications to go without ("prefer-no-csd") left some of them with no way to close by mouse.
// Always draw windows through the graphics chip. Handing a window's picture straight to a display
// plane ("direct scanout") makes this display controller flicker, most visibly with the browser.
debug {
    disable-direct-scanout
}
// Shabnam brand colours: deep navy backdrop, teal focus ring.
layout {
    // The screen is small (1280x720 after scaling): every window opens full width instead of
    // side by side. Mod+R cycles a window between half, two thirds and full width.
    default-column-width { proportion 1.0; }
    preset-column-widths { proportion 0.5; proportion 0.66667; proportion 1.0; }
    background-color "#061a33"
    focus-ring { width 3; active-color "#12c8c4"; inactive-color "#12364f"; }
}
hotkey-overlay { skip-at-startup; }
binds {
    Mod+Space { spawn "shabnam-shell" "toggle-launcher"; }
    Mod+D { spawn "shabnam-shell" "toggle-launcher"; }
    Mod+S { spawn "shabnam-shell" "toggle-quick"; }
    // foot draws with the processor, so it works on this graphics chip, and has a close button.
    Mod+T { spawn "foot"; }
    Mod+Return { spawn "foot"; }
    Mod+B { spawn "shabnam-browser"; }
    Mod+Q { close-window; }
    Alt+F4 { close-window; }
    Mod+W { close-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+F { maximize-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Tab { focus-column-right-or-first; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "sh" "-c" "shabnam-volume up; shabnam-shell osd volume"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "sh" "-c" "shabnam-volume down; shabnam-shell osd volume"; }
    XF86AudioMute allow-when-locked=true { spawn "sh" "-c" "shabnam-volume mute; shabnam-shell osd volume"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "sh" "-c" "shabnam-brightness up; shabnam-shell osd brightness"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "sh" "-c" "shabnam-brightness down; shabnam-shell osd brightness"; }
    // Become the Mac's second screen; the same key comes back here.
    Mod+Escape { spawn "sh" "-c" "echo mac > /run/mode; niri msg action quit --skip-confirmation"; }
    Mod+Shift+E { quit; }
}
