#!/bin/sh
# shabnam-browser — the Shabnam web browser: Chromium (Void's stable package), drawn natively on Wayland.
#
# Who it runs as: the desktop runs as root, and a browser must not. When started by root this script lets the
# unprivileged user "shabnam" (uid 700) reach the compositor's Wayland socket and the sound server's socket —
# and nothing else — then drops to that user. Started by anyone else it just runs.
#
# --no-sandbox: this Android kernel has no user namespaces and no PID namespaces (CONFIG_USER_NS and
#   CONFIG_PID_NS are off), so Chromium's sandbox cannot start at all; without this flag the browser exits
#   with "No usable sandbox!". Running as "shabnam" instead of root is the protection that is left: a
#   compromised page can reach that user's files, not the system. Drop the flag if the kernel ever gains
#   user namespaces.
# --disable-gpu-rasterization: pages are composited by the Mali GPU (smooth scrolling, WebGL) but painted on
#   the CPU. Painting on this GPU driver leaves the page blank on roughly every second start.
# --num-raster-threads=4: that CPU painting uses all four cores instead of the default two; a full-window
#   repaint measured 13.3 frames a second instead of 11.8.
# mali-finish (GL_FIX below): a small stand-in libEGL.so.1 that makes the graphics chip finish each window
#   picture before the desktop is given it. Without it the browser flickers: during scrolling, animations
#   and page changes, single frames show blocks of old and new content, because this Mali driver and kernel
#   give Chromium nothing to wait on. Measured with flicker-test/ (broken frames per screenshots taken):
#   8 of 156 without, 0 of 114 with, at about 39 instead of 44 frames a second. No Chromium flag and no
#   niri option removed it; software compositing (--disable-gpu) did, but at 10 frames a second and it
#   would rule out hardware video decoding. Source and details: mali-finish/mali-finish.c.
#   SHABNAM_GL_FINISH=0 shabnam-browser  starts a browser without the fix, to see the difference.
# Hardware video decoding (VA_DIR below): Chromium decodes H.264, VP8, VP9 and HEVC video on the Rockchip
#   decoder through VA-API, with the open-source driver rockchip_drv_video.so (build: ../vaapi/build.sh). The
#   driver sits in a directory of its own, so only this browser finds it. Measured with ../vaapi/chromium-test.sh,
#   1080p60 H.264: 8-16 % of the frames dropped with the browser using 1.4 cores, against 43 % and 2.9 cores
#   in software; 1080p30: 0.7 against 2.5 cores. Chromium needs no extra flags, only the three variables.
#   10-bit video is not offered (RKVA_HIDE_10BIT) and stays on the CPU, as does AV1 (the chip has no AV1 decoder).
#   SHABNAM_HW_VIDEO=0 shabnam-browser  starts a browser that decodes all video on the CPU.
umask 022   # the desktop's root shell runs with umask 0; the browser's files must not be world-writable
BROWSER_USER=shabnam
MALI_LIBS=/opt/mali/mali:/opt/mali:/opt/mpp2/usr/lib/aarch64-linux-gnu

socket=${WAYLAND_DISPLAY:-wayland-1}
case $socket in /*) ;; *) socket=${XDG_RUNTIME_DIR:-/run/user0}/$socket ;; esac

if [ "$(id -u)" = 0 ]; then
  uid=$(id -u "$BROWSER_USER") || { echo "shabnam-browser: user $BROWSER_USER is missing" >&2; exit 1; }
  # Only two sockets are handed to the browser user: the compositor's and the sound server's. They are
  # hard-linked into a directory that root owns, so root's own runtime directory stays closed (0700) and
  # the browser user cannot swap the links for something else.
  share=/run/shabnam-share
  mkdir -p "$share" && chown root:"$BROWSER_USER" "$share" && chmod 750 "$share" &&
    chgrp "$BROWSER_USER" "$socket" && chmod 660 "$socket" && ln -f "$socket" "$share/wayland-0" ||
    { echo "shabnam-browser: cannot share $socket with $BROWSER_USER" >&2; exit 1; }
  socket=$share/wayland-0
  pulse=${XDG_RUNTIME_DIR:-/run/user0}/pulse/native
  if [ -S "$pulse" ] && chgrp "$BROWSER_USER" "$pulse" && chmod 660 "$pulse" && ln -f "$pulse" "$share/pulse-native"
  then pulse=unix:$share/pulse-native; else pulse=; fi
  runtime=/run/user/$uid
  mkdir -p "$runtime" && chown "$BROWSER_USER:$BROWSER_USER" "$runtime" && chmod 700 "$runtime"
  home=$(getent passwd "$BROWSER_USER" | cut -d: -f6)
  cd "$home" || exit 1
  # The program must not keep the terminal this script was started from: with root's terminal
  # as its controlling terminal it could type into root's shell (TIOCSTI). New session, no
  # terminal file descriptors, and no way to gain privileges back.
  [ -t 0 ] && exec </dev/null; [ -t 1 ] && exec >/dev/null; [ -t 2 ] && exec 2>/dev/null
  exec setsid -w setpriv --no-new-privs --reuid "$BROWSER_USER" --regid "$BROWSER_USER" --init-groups \
    env -i HOME="$home" USER="$BROWSER_USER" LOGNAME="$BROWSER_USER" SHELL=/bin/sh \
      PATH=/usr/local/bin:/usr/bin:/bin LANG="${LANG:-zh_CN.UTF-8}" ${TZ:+TZ="$TZ"} \
      XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY="$socket" \
      PULSE_SERVER="$pulse" \
      LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-$MALI_LIBS}" \
      SHABNAM_BROWSER_FLAGS="$SHABNAM_BROWSER_FLAGS" \
      ${SHABNAM_GL_FINISH:+SHABNAM_GL_FINISH="$SHABNAM_GL_FINISH"} \
      ${SHABNAM_HW_VIDEO:+SHABNAM_HW_VIDEO="$SHABNAM_HW_VIDEO"} \
      "$0" "$@"
fi

# Ties the window to shabnam-browser.desktop (Wayland app-id "shabnam-browser").
export CHROME_DESKTOP=shabnam-browser.desktop
# Chromium has no Google API keys; this silences the bar it shows about that at every start.
export GOOGLE_API_KEY=no GOOGLE_DEFAULT_CLIENT_ID=no GOOGLE_DEFAULT_CLIENT_SECRET=no
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-$MALI_LIBS}"
# The flicker fix: Chromium's graphics process finds this libEGL.so.1 before the driver's own.
GL_FIX=/usr/local/lib/shabnam-browser-gl
case :$LD_LIBRARY_PATH: in *:$GL_FIX:*) ;; *) [ -r $GL_FIX/libEGL.so.1 ] && LD_LIBRARY_PATH=$GL_FIX:$LD_LIBRARY_PATH ;; esac
# Hardware video decoding: on when the driver is installed, unless SHABNAM_HW_VIDEO=0.
VA_DIR=/usr/local/lib/shabnam-va
if [ "${SHABNAM_HW_VIDEO:-1}" != 0 ] && [ -r $VA_DIR/rockchip_drv_video.so ]; then
  export LIBVA_DRIVERS_PATH=$VA_DIR LIBVA_DRIVER_NAME=rockchip RKVA_HIDE_10BIT=1
  video=
else
  unset LIBVA_DRIVERS_PATH LIBVA_DRIVER_NAME
  video=--disable-accelerated-video-decode
fi
exec /usr/lib/chromium/chromium \
  --ozone-platform=wayland \
  --no-sandbox \
  --disable-gpu-rasterization \
  --disable-features=WaylandOverlayDelegation \
  --enable-wayland-ime --wayland-text-input-version=3 \
  --password-store=basic \
  --no-first-run --no-default-browser-check \
  $video $SHABNAM_BROWSER_FLAGS "$@"
