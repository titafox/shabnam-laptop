--- a/linux-rust/device/shabnam-lid
+++ b/linux-rust/device/shabnam-lid
@@ -1,34 +1,70 @@
 #!/bin/sh
-# shabnam-lid close|open|state|start|stop — lid handling without suspend.
-#   close : backlight off        open : backlight on
+# shabnam-lid close|open|state|policy|start|stop — what closing the lid does.
+#   close : act on the policy below          open : undo it, backlight on
 #   state : "open" / "closed", read from the hall sensor line (gpio0-30, high = open)
+#   policy: the policy that applies right now
 #   start : watcher that calls close/open when the line changes; stop ends it
 # The hall driver only reports keys (KEY_SLEEP/KEY_WAKEUP), not a lid switch, and sends the
 # wake-up key only if it believes the screen is blanked — so the watcher reads the line itself.
+# Policy, in /etc/shabnam/lid.conf (read again at every lid movement):
+#   LID_POLICY=backlight     off | backlight | deep-idle | suspend   (see shabnam-suspend)
+#   LID_SUSPEND_IN_MAC=0     1: deep-idle/suspend also while the Mac second-screen mode is on
+#   LID_GRACE=3              seconds the lid must stay closed before deep-idle or suspend
+#   LID_RESUSPEND=60         woken with the lid still closed (charger, clock): sleep again after this
 B=/sys/class/backlight/backlight
 PID=/run/shabnam-lid.pid
 G=/sys/kernel/debug/gpio
+CONF=/etc/shabnam/lid.conf
 state() {
   [ -r $G ] || mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
   case "$(grep hall_mh248 $G 2>/dev/null)" in
     *" lo"*) echo closed ;; *" hi"*) echo open ;; *) echo unknown ;;
   esac
 }
+load() {
+  LID_POLICY=backlight LID_SUSPEND_IN_MAC=0 LID_GRACE=3 LID_RESUSPEND=60
+  [ -r $CONF ] && . $CONF
+}
+policy() {
+  load; p=$LID_POLICY
+  case $p in off|backlight) ;;
+    deep-idle|suspend)
+      command -v shabnam-suspend >/dev/null || p=backlight
+      [ "$(cat /run/mode 2>/dev/null)" = mac ] && [ "$LID_SUSPEND_IN_MAC" != 1 ] && p=backlight ;;
+    *) p=backlight ;;
+  esac
+  echo $p
+}
 running() { [ -s $PID ] && kill -0 "$(cat $PID)" 2>/dev/null; }
 case "$1" in
-  close) echo 4 > $B/bl_power ;;
-  open)  echo 0 > /sys/class/graphics/fb0/blank; echo 0 > $B/bl_power ;;
+  close|closed)
+    load; p=$(policy)
+    [ $p = off ] && exit 0
+    echo 4 > $B/bl_power
+    [ $p = backlight ] && exit 0
+    sleep "$LID_GRACE"; [ "$(state)" = closed ] || { echo 0 > $B/bl_power; exit 0; }
+    if [ $p = deep-idle ]; then shabnam-suspend deep-idle on
+    else shabnam-suspend mem 0 --lid || echo "$(date) suspend did not work ($?); backlight stays off" >&2; fi ;;
+  open)
+    [ -e /run/shabnam-deepidle.state ] && shabnam-suspend deep-idle off
+    echo 0 > /sys/class/graphics/fb0/blank; echo 0 > $B/bl_power ;;
   state) state ;;
-  start) running || setsid "$0" watch >/dev/null 2>&1 </dev/null & ;;
+  policy) policy ;;
+  start) running || setsid "$0" watch >>/var/log/shabnam/lid.log 2>&1 </dev/null & ;;
   watch)
     echo $$ > $PID
-    last=$(state)
+    last=$(state); awake=0
     while :; do
       sleep 1
       now=$(state)
-      [ "$now" = "$last" ] || [ "$now" = unknown ] && continue
-      last=$now; "$0" "$now"
+      [ "$now" = unknown ] && continue
+      if [ "$now" != "$last" ]; then last=$now; awake=0; "$0" "$now"; continue; fi
+      # Asleep is asleep: this loop only runs while the machine is awake. Awake with the lid
+      # still closed means something else woke it; go back to sleep after a while.
+      [ "$now" = closed ] || continue
+      awake=$((awake+1)); [ $((awake % 10)) -eq 0 ] || continue
+      load; [ $awake -ge "$LID_RESUSPEND" ] && [ "$(policy)" = suspend ] && { awake=0; "$0" close; }
     done ;;
   stop) running && kill "$(cat $PID)"; rm -f $PID ;;
-  *) echo "usage: shabnam-lid close|open|state|start|stop" >&2; exit 2 ;;
+  *) echo "usage: shabnam-lid close|open|state|policy|start|stop" >&2; exit 2 ;;
 esac
