#!/bin/sh
# shabnam-music [FILE ...] — the music player: Gem Player (linux-rust/apps/gem-player/build.sh), run
# as the unprivileged user through shabnam-userapp.
#   shabnam-music              the library: every audio file under /home/shabnam/Music
#   shabnam-music song.mp3     plays that file, then the other audio files of its folder
# Sound: SHABNAM_APP_SOUND=1 makes shabnam-userapp hand the program the sound server's socket
# (PULSE_SERVER); Gem Player speaks the PulseAudio protocol to PipeWire itself (no ALSA device needed).
# It keeps playing when its window is not focused or is on another workspace.
# The interface language follows LANG (Chinese, Russian and English are built in). It draws with
# OpenGL ES (egui's glow renderer), never looks for updates and does not use the network.
#
# One player at a time: a file opened from the file manager while a player is running is handed to
# that player, which plays it in its window (our patch: the second gem-player writes the file names
# to the first one's socket, /run/user/700/gem-player.sock, and ends). Without files a second
# start opens a second window, as upstream.
SHABNAM_APP_SOUND=1 exec shabnam-userapp /usr/local/lib/gem-player/gem-player "$@"
