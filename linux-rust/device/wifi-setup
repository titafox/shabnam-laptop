#!/bin/sh
# wifi-setup — choose the Wi-Fi network this machine uses. Run it in a terminal on the laptop.
# The password is typed here and stored only on this machine (readable by root only).
CONF=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
now=$(iw dev wlan0 link 2>/dev/null | sed -n 's/^\s*SSID: //p')
printf 'Network name%s: ' "${now:+ [$now]}"
read -r ssid
[ -z "$ssid" ] && ssid=$now
[ -z "$ssid" ] && { echo "no network name given"; exit 1; }
printf 'Password (not shown while typing): '
stty -echo; read -r pass; stty echo; echo
[ ${#pass} -ge 8 ] || { echo "a Wi-Fi password has at least 8 characters"; exit 1; }
umask 077
mkdir -p /etc/wpa_supplicant
{
  echo 'ctrl_interface=/run/wpa_supplicant'
  echo 'update_config=1'
  # wpa_passphrase also prints the password as a comment; keep only the derived key.
  wpa_passphrase "$ssid" "$pass" | grep -v '^\s*#psk='
} > $CONF.new || exit 1
unset pass
mv $CONF.new $CONF
echo "Saved. Connecting…"
exec wifi-up
